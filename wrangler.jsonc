{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apac-uploader",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "UPLOADER", "class_name": "Uploader" }]
  },
  // Stateless DO (no storage) — plain classes, not sqlite.
  "migrations": [{ "tag": "v1", "new_classes": ["Uploader"] }],
  // Region to run the upload from (near your target). Default is apac; override
  // for a different destination — see the DurableObjectLocationHint values.
  "vars": { "LOCATION_HINT": "apac" }
}
